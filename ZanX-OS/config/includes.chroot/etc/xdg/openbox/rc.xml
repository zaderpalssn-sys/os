<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.5/rc"
    xmlns:xi="http://www.w3.org/2001/XInclude">

  <resistance>
    <strength>10</strength>
    <screen_edge_strength>20</screen_edge_strength>
  </resistance>

  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
    <focusDelay>0</focusDelay>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <placement>
    <policy>Smart</policy>
    <center>no</center>
  </placement>

  <theme>
    <name>ZanX</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>yes</keepBorder>
    <animateIconify>no</animateIconify>
    <font place="ActiveWindow">
      <name>DejaVu Sans</name><size>9</size><weight>bold</weight>
    </font>
    <font place="InactiveWindow">
      <name>DejaVu Sans</name><size>9</size><weight>bold</weight>
    </font>
    <font place="MenuHeader">
      <name>DejaVu Sans</name><size>9</size><weight>bold</weight>
    </font>
    <font place="MenuItem">
      <name>DejaVu Sans</name><size>9</size><weight>normal</weight>
    </font>
    <font place="OnScreenDisplay">
      <name>DejaVu Sans Mono</name><size>9</size><weight>bold</weight>
    </font>
  </theme>

  <desktops>
    <number>2</number>
    <firstdesk>1</firstdesk>
    <names>
      <name>Desk 1</name>
      <name>Desk 2</name>
    </names>
  </desktops>

  <resize>
    <drawContents>yes</drawContents>
    <popupShow>Nonpixel</popupShow>
    <popupPosition>ActiveWindow</popupPosition>
  </resize>

  <margins>
    <top>0</top>
    <bottom>28</bottom>
    <left>0</left>
    <right>0</right>
  </margins>

  <menu>
    <file>menu.xml</file>
    <hideDelay>200</hideDelay>
    <middle>no</middle>
    <submenuShowDelay>100</submenuShowDelay>
    <applicationIcons>yes</applicationIcons>
  </menu>

  <keyboard>
    <keybind key="W-e"><action name="Execute"><command>zanx-explorer</command></action></keybind>
    <keybind key="W-t"><action name="Execute"><command>xterm</command></action></keybind>
    <keybind key="W-n"><action name="Execute"><command>zanx-notepad</command></action></keybind>
    <keybind key="W-r"><action name="Execute"><command>zanx-winrar</command></action></keybind>
    <keybind key="W-f"><action name="Execute"><command>firefox-esr</command></action></keybind>
    <keybind key="W-m"><action name="ShowMenu"><menu>root-menu</menu></action></keybind>
    <keybind key="A-F4"><action name="Close"/></keybind>
    <keybind key="A-F2"><action name="Execute"><command>openbox --reconfigure</command></action></keybind>
  </keyboard>

  <mouse>
    <dragThreshold>1</dragThreshold>
    <doubleClickTime>500</doubleClickTime>
    <screenEdgeWarpTime>400</screenEdgeWarpTime>
    <contextMenu>
      <mousebind action="Press" button="Right">
        <action name="ShowMenu"><menu>root-menu</menu></action>
      </mousebind>
    </contextMenu>
  </mouse>

  <dock>
    <position>BottomRight</position>
    <floatingX>0</floatingX>
    <floatingY>0</floatingY>
    <noStrut>no</noStrut>
    <stacking>Above</stacking>
    <direction>Vertical</direction>
    <autoHide>no</autoHide>
    <hideDelay>300</hideDelay>
    <showDelay>300</showDelay>
    <moveButton>Middle</moveButton>
  </dock>

</openbox_config>
