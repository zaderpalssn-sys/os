# ZanX OS classic 2000s panel
panel_items = LTSBC
panel_position = bottom center horizontal
panel_size = 100% 28
panel_margin = 0 0
panel_padding = 2 2 2
panel_background_id = 1
wm_menu = 1
wm_menu_bind_mouse = 3
wm_menu_app = 1
wm_menu_key = F1
panel_autohide = 0
panel_layer = top
panel_monitor = all

taskbar_mode = multi_desktop
taskbar_padding = 2 2 2
taskbar_background_id = 2
taskbar_active_background_id = 3
task_icon = 1
task_text = 1
task_centered = 0
task_maximum_size = 220 24
task_padding = 3 2 3
task_tooltip = 1
task_iconified = 1
