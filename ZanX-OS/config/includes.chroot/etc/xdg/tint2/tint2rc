task_urgent = 1
task_font = DejaVu Sans 9
task_font_color = #c0c0c0 100
task_active_font_color = #ffffff 100
task_urgent_font_color = #ffffff 100
task_iconified_font_color = #808080 100

launcher_padding = 2 2 2
launcher_background_id = 2
launcher_icon_size = 20
launcher_icon_theme = ZanX
launcher_icon_asb = 100 0 0
launcher_item_app = /usr/share/applications/zanx-explorer.desktop
